    {
      "type": "text",
      "id": "text-24",
      "x": 54,
      "y": 455,
      "width": 930,
      "height": 35,
      "text": "Without batching: 1000 groups x 2 peers = 2000 separate RPCs every heartbeat - the network,",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-25",
      "x": 54,
      "y": 487,
      "width": 930,
      "height": 35,
      "text": "not Raft, becomes the bottleneck. With batching: at most (peers) envelopes per node, so the",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-26",
      "x": 54,
      "y": 519,
      "width": 930,
      "height": 35,
      "text": "wire cost is bounded by peer pairs. The tests hold this at 2000 groups (<= 6 envelopes).",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-27",
      "x": 40,
      "y": 575,
      "width": 980,
      "height": 32,
      "text": "Consensus itself (elections, log replication) is the sibling mini-raft; this is the layer that runs a swarm of them.",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
  ],
